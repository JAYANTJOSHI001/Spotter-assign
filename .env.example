# Django Core
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database & Cache
DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=

# Routing & Upstream Providers
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
ORS_API_KEY=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=fuelroute-assessment/1.0 (contact: you@example.com)

# Vehicle & Fuel Planning Parameters
MAX_RANGE_MILES=500
MPG=10
START_MODE=priced
STATION_PRICE_POLICY=min

# Corridor & Safety Parameters
CORRIDOR_MILES=10,25,50
DETOUR_FACTOR=2.0
SAFETY_RESERVE_MILES=0

# Operational Budgets & Rate Limits
EXTERNAL_CALL_BUDGET=3
UPSTREAM_TIMEOUT_S=8
CACHE_TTL_S=86400
RATE_LIMIT_PER_MIN=60

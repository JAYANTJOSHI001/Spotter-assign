                  "        pm.expect(stops[i].mile_marker).to.be.at.least(stops[i-1].mile_marker);",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"No gap > 500 miles between consecutive stops\", function () {",
                  "    var stops = data.fuel_plan.stops;",
                  "    var maxRange = data.route.parameters ? data.route.parameters.max_range_miles : 500;",
                  "    var pos = 0.0;",
                  "    for (var i = 0; i < stops.length; i++) {",
                  "        var leg = stops[i].mile_marker - pos;",
                  "        pm.expect(leg).to.be.at.most(maxRange + 1.0);",
                  "        pos = stops[i].mile_marker;",
                  "    }",
                  "    var finalLeg = data.route.distance_miles - pos;",
                  "    pm.expect(finalLeg).to.be.at.most(maxRange + 1.0);",
                  "});",
                  "",
                  "// Postman Visualizer Table",
                  "var template = `",
                  "<style>",
                  "  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0f172a; color: #f8fafc; padding: 20px; }",
                  "  h2 { color: #38bdf8; margin-bottom: 8px; }",
                  "  .summary { display: flex; gap: 20px; margin-bottom: 20px; background: #1e293b; padding: 15px; border-radius: 8px; border: 1px solid #334155; }",
                  "  .summary div { flex: 1; }",
                  "  .summary span { display: block; font-size: 12px; color: #94a3b8; text-transform: uppercase; }",
                  "  .summary strong { font-size: 20px; color: #f8fafc; }",
                  "  table { width: 100%; border-collapse: collapse; background: #1e293b; border-radius: 8px; overflow: hidden; }",
                  "  th, td { padding: 12px 16px; text-align: left; }",
                  "  th { background: #334155; color: #cbd5e1; font-size: 13px; text-transform: uppercase; }",
                  "  tr:nth-child(even) { background: #182234; }",
                  "  tr:hover { background: #233554; }",
                  "  .price { font-family: monospace; font-weight: 600; color: #34d399; }",
                  "</style>",
                  "<h2>FuelRoute Plan: {{response.route.start.label}} → {{response.route.finish.label}}</h2>",
                  "<div class='summary'>",
                  "  <div><span>Total Distance</span><strong>{{response.route.distance_miles}} mi</strong></div>",
                  "  <div><span>Fuel Stops</span><strong>{{response.fuel_plan.stops.length}}</strong></div>",
                  "  <div><span>Total Gallons</span><strong>{{response.fuel_plan.totals.total_fuel_gallons}} gal</strong></div>",
                  "  <div><span>Total Fuel Cost</span><strong style='color:#34d399;'>${{response.fuel_plan.totals.total_fuel_cost_usd}}</strong></div>",
                  "  <div><span>External Calls</span><strong>{{response.meta.external_calls}}</strong></div>",
                  "</div>",
                  "<table>",
                  "  <thead>",
                  "    <tr>",
                  "      <th>#</th>",
                  "      <th>Station</th>",
                  "      <th>Location</th>",
                  "      <th>Mile Marker</th>",
                  "      <th>Detour</th>",
                  "      <th>Price / Gal</th>",
                  "      <th>Gallons</th>",
                  "      <th>Cost</th>",
                  "    </tr>",
                  "  </thead>",
                  "  <tbody>",
                  "    {{#each response.fuel_plan.stops}}",
                  "    <tr>",
                  "      <td>{{sequence}}</td>",
                  "      <td><strong>{{station_name}}</strong> (OPIS #{{opis_id}})</td>",
                  "      <td>{{city}}, {{state}}</td>",
                  "      <td>{{mile_marker}} mi</td>",
                  "      <td>+{{detour_miles}} mi</td>",
                  "      <td class='price'>${{price_usd_gal}}</td>",
                  "      <td>{{gallons}} gal</td>",
                  "      <td><strong>${{cost_usd}}</strong></td>",
                  "    </tr>",
                  "    {{/each}}",
                  "  </tbody>",
                  "</table>",
                  "`;",
                  "pm.visualizer.set(template, { response: data });"
                ],
                "type": "text/javascript"
              }
            }
          ]

  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "Short Trip (Chicago, IL → St. Louis, MO)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"St. Louis, MO\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/route",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "route"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var data = pm.response.json();",
                  "",
                  "pm.test(\"Total fuel cost is a valid number\", function () {",
                  "    pm.expect(data.fuel_plan.totals.total_fuel_cost_usd).to.be.a('number');",
                  "    pm.expect(data.fuel_plan.totals.total_fuel_cost_usd).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"External call budget is respected (<= 3)\", function () {",
                  "    pm.expect(data.meta.external_calls).to.be.at.most(3);",
                  "});",
                  "",
                  "pm.test(\"Stops ordered by mile marker\", function () {",
                  "    var stops = data.fuel_plan.stops;",
                  "    for (var i = 1; i < stops.length; i++) {",
                  "        pm.expect(stops[i].mile_marker).to.be.at.least(stops[i-1].mile_marker);",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"No gap > 500 miles between consecutive stops\", function () {",
                  "    var stops = data.fuel_plan.stops;",
                  "    var maxRange = data.route.parameters ? data.route.parameters.max_range_miles : 500;",
                  "    var pos = 0.0;",
                  "    for (var i = 0; i < stops.length; i++) {",
                  "        var leg = stops[i].mile_marker - pos;",
                  "        pm.expect(leg).to.be.at.most(maxRange + 1.0);",
                  "        pos = stops[i].mile_marker;",
                  "    }",
                  "    var finalLeg = data.route.distance_miles - pos;",
                  "    pm.expect(finalLeg).to.be.at.most(maxRange + 1.0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
